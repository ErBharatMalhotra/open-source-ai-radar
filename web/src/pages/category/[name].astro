---
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;

// Load data
let index: any = { projects: [] };
let repoHistory: Record<string, number[]> = {"affaan-m/ECC": [241862], "anomalyco/opencode": [200055], "awesome-selfhosted/awesome-selfhosted": [314209], "firecrawl/firecrawl": [170649], "f/prompts.chat": [167718], "microsoft/markitdown": [175318], "n8n-io/n8n": [201565], "NousResearch/hermes-agent": [234062], "ollama/ollama": [179138], "Significant-Gravitas/AutoGPT": [186737]};
try { index = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'projects-index.json'), 'utf-8')); } catch {}

let intelligence: any = { categories: [] };
try { intelligence = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'category-intelligence.json'), 'utf-8')); } catch {}

export function getStaticPaths() {
  let cats: any = { categories: [] };
  try { cats = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'category-intelligence.json'), 'utf-8')); } catch {}
  return (cats.categories || []).map((c: any) => ({
    params: { name: c.category.toLowerCase().replace(/[^a-z0-9]+/g, '-') },
    props: { category: c.category },
  }));
}

const { category } = Astro.props;

// Filter projects by category
const projects = (index.projects || [])
  .filter((p: any) => p.category === category)
  .sort((a: any, b: any) => {
      const sa = a.radar_score || 0;
      const sb = b.radar_score || 0;
      if (sa !== sb) return sb - sa;
      return (b.stars || 0) - (a.stars || 0);
    });

// Find category metadata
const catMeta = (intelligence.categories || []).find((c: any) => c.category === category);

function fmtStars(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}


function sparkline(stars: number[]): string {
  if (!stars || stars.length < 2) return '';
  const w = 60, h = 20, pad = 2;
  const min = Math.min(...stars), max = Math.max(...stars);
  const range = max - min || 1;
  const step = (w - pad * 2) / (stars.length - 1);
  const pts = stars.map((v, i) => {
    const x = pad + i * step;
    const y = h - pad - ((v - min) / range) * (h - pad * 2);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  const rising = stars[stars.length - 1] >= stars[0];
  const color = rising ? 'var(--green)' : 'var(--red)';
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="${pts.join(' ')}" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
}

function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}

function momentumBadge(score: number): { label: string; cls: string } {
  if (score >= 80) return { label: 'Breakout', cls: 'badge-accent' };
  if (score >= 65) return { label: 'Accelerating', cls: 'badge-success' };
  if (score >= 45) return { label: 'Rising', cls: 'badge-info' };
  if (score > 0) return { label: 'Stable', cls: 'badge-muted' };
  return { label: '—', cls: 'badge-muted' };
}
---

<Layout title={`${category} — Open Source AI Radar`} description={`Top open-source AI projects in the ${category} category.`}>
  <section class="hero-editorial" style="padding-bottom:var(--sp-6);">
    <nav style="font-size:var(--text-sm); color:var(--text-muted); margin-bottom:var(--sp-4);">
      <a href={`${base}categories`} style="color:var(--accent); text-decoration:none;">Categories</a>
      <span style="margin:0 var(--sp-2);">/</span>
      <span>{category}</span>
    </nav>
    <h1 style="font-size:var(--text-2xl);">{category}</h1>
    <p style="color:var(--text-muted); margin-top:var(--sp-2);">
      {projects.length} projects tracked
      {catMeta?.trend && <span class={`badge badge-sm ${catMeta.trend === 'rising' ? 'badge-success' : catMeta.trend === 'declining' ? 'badge-warning' : 'badge-muted'}`} style="margin-left:var(--sp-2);">{catMeta.trend}</span>}
    </p>
  </section>

  {catMeta && (
    <div style="display:flex; gap:var(--sp-6); margin-bottom:var(--sp-8); flex-wrap:wrap;">
      <div class="card" style="padding:var(--sp-4); min-width:120px;">
        <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase;">Tracked</div>
        <div style="font-size:var(--text-xl); font-weight:700;">{catMeta.tracked}</div>
      </div>
      <div class="card" style="padding:var(--sp-4); min-width:120px;">
        <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase;">Avg Velocity</div>
        <div style="font-size:var(--text-xl); font-weight:700;">{catMeta.velocity?.toFixed(0) || '—'}</div>
      </div>
      <div class="card" style="padding:var(--sp-4); min-width:120px;">
        <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase;">Avg Health</div>
        <div style="font-size:var(--text-xl); font-weight:700;">{catMeta.health?.toFixed(0) || '—'}</div>
      </div>
    </div>
  )}

  <div style="display:flex; flex-direction:column; gap:var(--sp-3);">
    {projects.map((p: any, i: number) => {
      const mb = momentumBadge(p.radar_score || 0);
      return (
        <a href={repoUrl(p.full_name)} class="project-row" style="text-decoration:none; color:inherit;">
          <div style="display:flex; align-items:center; gap:var(--sp-4);">
            <span style="font-size:var(--text-sm); color:var(--text-muted); min-width:32px; text-align:right;">#{i + 1}</span>
            <img src={p.owner_avatar || ''} alt="" style="width:28px; height:28px; border-radius:50%;" loading="lazy" data-owner={p.full_name} crossorigin="anonymous" />
            <div style="flex:1; min-width:0;">
              <div style="font-weight:600; font-size:var(--text-sm); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{p.full_name}</div>
              <div style="font-size:var(--text-xs); color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:400px;">{p.description || ''}</div>
            </div>
            <div style="display:flex; gap:var(--sp-4); align-items:center; flex-shrink:0;">
              {p.language && <span class="badge badge-sm badge-muted">{p.language}</span>}
              <span style="font-size:var(--text-sm); font-weight:600; min-width:60px; text-align:right;">{fmtStars(p.stars)} ★</span>
              <span style="font-size:var(--text-sm); font-weight:700; min-width:40px; text-align:right;">{p.radar_score ? p.radar_score.toFixed(0) : "—"}</span>
              <Fragment set:html={sparkline(repoHistory[p.full_name] || [])} />
              <span class={`badge badge-sm ${mb.cls}`}>{mb.label}</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  {projects.length === 0 && (
    <div class="card" style="padding:var(--sp-8); text-align:center; color:var(--text-muted);">
      No projects found in this category yet.
    </div>
  )}
</Layout>
