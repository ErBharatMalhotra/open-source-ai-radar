---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
let repos: any[] = [];
try {
  const data = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'trending.json'), 'utf-8'));
  repos = data.repos || data.trending || [];
} catch {}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}
function momentumState(v: number, a: number): string {
  if (a >= 2.0 && v >= 60) return 'breakout';
  if (a >= 1.5 && v >= 50) return 'accelerating';
  if (v >= 40) return 'rising';
  if (v >= 20) return 'stable';
  return 'declining';
}
function momentumLabel(s: string): string {
  return ({ breakout: 'Breakout', accelerating: 'Accelerating', rising: 'Rising', stable: 'Stable', declining: 'Declining' } as any)[s] || '—';
}
function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}
---

<Layout title="Trending" description="AI open-source projects gaining momentum right now.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1><span class="accent">Trending</span> Projects</h1>
    <p>Projects gaining the most momentum this week</p>
  </section>

  <div class="grid-auto">
    {repos.slice(0, 30).map((r: any) => {
      const state = momentumState(r.velocity || 0, r.star_growth_acceleration || 1);
      const name = r.full_name || r.repo_full_name || '';
      return (
        <a href={repoUrl(name)} class="card card-link" style="padding:var(--sp-5); text-decoration:none; color:inherit;">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--sp-2);">
            <span style="font-weight:600; font-size:var(--text-sm);">{name.split('/')[1]}</span>
            <span class={`momentum momentum-${state}`}>{momentumLabel(state)}</span>
          </div>
          <div style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--sp-3);">
            {name.split('/')[0]} · {r.language || ''} · {fmt(r.stars || 0)} stars
          </div>
          <div style="display:flex; gap:var(--sp-4); font-size:var(--text-xs); color:var(--text-secondary);">
            <span>Velocity: {r.velocity?.toFixed(0)}</span>
            <span>Score: {r.radar_score?.toFixed(1)}</span>
          </div>
        </a>
      );
    })}
  </div>
</Layout>
