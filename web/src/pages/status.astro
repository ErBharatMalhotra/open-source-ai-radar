---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
let stats: any = {};
try { stats = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'stats.json'), 'utf-8')); } catch {}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}

const lastUpdate = stats.last_updated || new Date().toISOString();
---

<Layout title="Status" description="Pipeline status and system health.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1>System <span class="accent">Status</span></h1>
    <p>Current pipeline health and data freshness</p>
  </section>

  <div class="stat-grid" style="margin-bottom:var(--sp-12);">
    <div class="stat-card">
      <div class="stat-value" style="color:var(--green);">Online</div>
      <div class="stat-label">Pipeline Status</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{(stats.total_repos || 0).toLocaleString()}</div>
      <div class="stat-label">Repos Tracked</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{fmt(stats.total_stars || 0)}</div>
      <div class="stat-label">Total Stars</div>
    </div>
  </div>

  <section class="section">
    <div class="section-head"><h2>Data Freshness</h2></div>
    <div class="card" style="padding:var(--sp-6);">
      <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:var(--sp-4);">
        <div>
          <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:var(--tracking-wide);">Last Updated</div>
          <div style="font-size:var(--text-sm); margin-top:var(--sp-1);">{lastUpdate}</div>
        </div>
        <div>
          <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:var(--tracking-wide);">Pipeline</div>
          <div style="font-size:var(--text-sm); margin-top:var(--sp-1);">GitHub Actions (auto)</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Workflows</h2></div>
    <div class="grid-2">
      <div class="card" style="padding:var(--sp-5);">
        <div style="font-weight:600; margin-bottom:var(--sp-2);">Discover</div>
        <div style="font-size:var(--text-xs); color:var(--text-secondary);">Runs 2x/day. Searches GitHub for new AI projects.</div>
        <div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--sp-2);">02:00 UTC, 14:00 UTC</div>
      </div>
      <div class="card" style="padding:var(--sp-5);">
        <div style="font-weight:600; margin-bottom:var(--sp-2);">Process</div>
        <div style="font-size:var(--text-xs); color:var(--text-secondary);">Runs 4x/day. Snapshots and scores repos by tier.</div>
        <div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--sp-2);">04:00, 10:00, 16:00, 22:00 UTC</div>
      </div>
      <div class="card" style="padding:var(--sp-5);">
        <div style="font-weight:600; margin-bottom:var(--sp-2);">Deploy</div>
        <div style="font-size:var(--text-xs); color:var(--text-secondary);">On push to main. Builds and deploys website.</div>
        <div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--sp-2);">Automatic</div>
      </div>
      <div class="card" style="padding:var(--sp-5);">
        <div style="font-weight:600; margin-bottom:var(--sp-2);">Weekly Report</div>
        <div style="font-size:var(--text-xs); color:var(--text-secondary);">Monday 08:00 UTC. Generates report + social drafts.</div>
        <div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--sp-2);">Monday 08:00 UTC</div>
      </div>
    </div>
  </section>
</Layout>
