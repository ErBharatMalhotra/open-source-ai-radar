---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
let intelligence: any = { categories: [] };
try { intelligence = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'category-intelligence.json'), 'utf-8')); } catch {}

function catUrl(name: string): string {
  return `${base}category/${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
}

function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}
---

<Layout title="AI Ecosystem Map & Categories" description="Open source AI ecosystem map: category-wise momentum intelligence, tracked counts, and velocity metrics across 11 architectural layers.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1>AI Ecosystem <span class="accent">Map</span> &amp; Categories</h1>
    <p>{intelligence.categories?.length || 0} tracked AI open-source categories mapped by momentum, velocity, and architectural layer.</p>
  </section>

  {/* Ecosystem Map Overview Card */}
  <div class="card" style="padding:var(--sp-6); margin-bottom:var(--sp-8); background:var(--bg-surface); border:1px solid var(--border);">
    <h2 style="font-size:var(--text-lg); font-weight:700; margin-bottom:var(--sp-3);">🗺️ Open Source AI Architectural Landscape</h2>
    <p style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.6; margin-bottom:var(--sp-4);">
      The AI open-source ecosystem is organized into core layers ranging from foundational LLM frameworks and local inference runtimes to autonomous agent harnesses and Model Context Protocol (MCP) toolchains.
    </p>
    <div style="display:flex; flex-wrap:wrap; gap:var(--sp-3);">
      {(intelligence.categories || []).map((cat: any) => (
        <a href={catUrl(cat.category)} class="filter-pill" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
          <span>{cat.category}</span>
          <span style="background:var(--accent); color:#000; font-size:10px; font-weight:700; padding:1px 6px; border-radius:10px;">{cat.tracked}</span>
        </a>
      ))}
    </div>
  </div>

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--sp-6);">
    <h2 style="font-size:var(--text-xl); font-weight:700;">Category Momentum Intelligence</h2>
    <span style="font-size:var(--text-xs); color:var(--text-muted); font-family:var(--font-mono);">Refreshed 6x daily</span>
  </div>

  <div class="grid-2">
    {(intelligence.categories || []).map((cat: any) => (
      <div class="card" style="padding:var(--sp-6); display:flex; flex-direction:column; justify-content:space-between;">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:var(--sp-4);">
            <h3 style="font-size:var(--text-lg); font-weight:700;"><a href={catUrl(cat.category)} style="color:var(--accent); text-decoration:none;">{cat.category}</a></h3>
            <span class="badge" style="background:var(--bg-surface); color:var(--text-secondary);">{cat.tracked} repos</span>
          </div>

          <div style="display:flex; gap:var(--sp-6); margin-bottom:var(--sp-4);">
            <div>
              <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase;">Velocity</div>
              <div style="font-size:var(--text-xl); font-weight:700; color:var(--green);">{cat.velocity?.toFixed(1) || '—'}</div>
            </div>
            {cat.avg_stars && (
              <div>
                <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase;">Avg Stars</div>
                <div style="font-size:var(--text-xl); font-weight:700;">{fmt(cat.avg_stars)}</div>
              </div>
            )}
            {cat.health && (
              <div>
                <div style="font-size:var(--text-xs); color:var(--text-muted); text-transform:uppercase;">Health</div>
                <div style="font-size:var(--text-xl); font-weight:700; color:var(--accent);">{cat.health?.toFixed(1)}</div>
              </div>
            )}
          </div>
        </div>

        {cat.top_project && (
          <div style="border-top:1px solid var(--border-subtle); padding-top:var(--sp-3);">
            <div style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:2px;">Top Project</div>
            <a href={repoUrl(cat.top_project)} style="display:inline-block; font-size:var(--text-sm); font-weight:600; color:var(--text); text-decoration:none;">
              {cat.top_project} ↗
            </a>
          </div>
        )}
      </div>
    ))}
  </div>
</Layout>
