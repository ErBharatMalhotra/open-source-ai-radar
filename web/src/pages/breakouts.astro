---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
let breakouts: any = { candidates: [] };
try { breakouts = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'breakouts.json'), 'utf-8')); } catch {}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}
function scoreClass(s: number): string {
  if (s >= 75) return 'score-high';
  if (s >= 50) return 'score-mid';
  return 'score-low';
}
function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}
---

<Layout title="Breakouts" description="Projects predicted to break out based on momentum signals.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1><span class="accent">Breakout</span> Candidates</h1>
    <p>Projects showing early signs of explosive growth</p>
  </section>

  <div class="grid-auto">
    {(breakouts.candidates || []).map((r: any, i: number) => (
      <a href={repoUrl(r.repo_full_name)} class="card card-link" style="padding:var(--sp-6); text-decoration:none; color:inherit;">
        <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-3);">
          <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-muted);">#{i + 1}</span>
          <span style="font-weight:700; font-size:var(--text-base);">{r.repo_full_name}</span>
        </div>
        <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-4);">
          <span class={`score-pill ${scoreClass(r.breakout_score)}`}>{r.breakout_score}</span>
          <span class="momentum momentum-breakout">Breakout</span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:var(--sp-3);">
          <div>
            <div style="font-size:var(--text-xs); color:var(--text-muted);">Stars</div>
            <div style="font-size:var(--text-sm); font-weight:600;">{fmt(r.stars || 0)}</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs); color:var(--text-muted);">Velocity</div>
            <div style="font-size:var(--text-sm); font-weight:600;">{r.velocity?.toFixed(0)}</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs); color:var(--text-muted);">Acceleration</div>
            <div style="font-size:var(--text-sm); font-weight:600;">{r.star_growth_acceleration?.toFixed(1)}x</div>
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>
