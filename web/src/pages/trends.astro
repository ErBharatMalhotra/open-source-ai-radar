---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
let trends: any = {};
try { trends = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'trends.json'), 'utf-8')); } catch {}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}
function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}
---

<Layout title="Trends" description="AI open-source trends: rising stars, hidden gems, and anomalies.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1><span class="accent">Trends</span> &amp; Signals</h1>
    <p>Anomalies, rising stars, hidden gems, and category momentum</p>
  </section>

  {trends.anomalies && trends.anomalies.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Anomalies Detected</h2></div>
      <div class="grid-auto">
        {trends.anomalies.slice(0, 6).map((a: any) => (
          <div class="card" style="padding:var(--sp-5); border-left:3px solid var(--amber);">
            <div style="font-size:var(--text-xs); color:var(--amber); text-transform:uppercase; letter-spacing:var(--tracking-wide); margin-bottom:var(--sp-2);">
              {a.trend_direction === 'up' ? 'Score Jump' : 'Score Drop'}
            </div>
            <a href={repoUrl(a.repo_full_name)} style="font-weight:600; color:var(--text); text-decoration:none; font-size:var(--text-sm);">{a.repo_full_name}</a>
            <div style="margin-top:var(--sp-2); font-size:var(--text-xs); color:var(--text-secondary);">
              <span class={a.score_change > 0 ? 'score-high' : 'score-low'} style="font-weight:600;">
                {a.score_change > 0 ? '+' : ''}{a.score_change?.toFixed(1)} pts
              </span>
              <span style="margin-left:var(--sp-3); color:var(--text-muted);">{fmt(a.stars || 0)} stars</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {trends.top_rising && trends.top_rising.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Rising Stars</h2></div>
      <div class="grid-auto">
        {trends.top_rising.slice(0, 8).map((r: any) => (
          <a href={repoUrl(r.repo_full_name)} class="card card-link" style="padding:var(--sp-5); text-decoration:none; color:inherit;">
            <div style="font-weight:600; font-size:var(--text-sm); margin-bottom:var(--sp-2);">{r.repo_full_name}</div>
            <div style="font-size:var(--text-xs); color:var(--text-secondary);">
              {fmt(r.stars || 0)} stars · {r.language || '—'}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {trends.hidden_gems && trends.hidden_gems.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Hidden Gems</h2></div>
      <div class="grid-auto">
        {trends.hidden_gems.slice(0, 8).map((r: any) => (
          <a href={repoUrl(r.repo_full_name)} class="card card-link" style="padding:var(--sp-5); text-decoration:none; color:inherit; border-left:3px solid var(--green);">
            <div style="font-weight:600; font-size:var(--text-sm); margin-bottom:var(--sp-2);">{r.repo_full_name}</div>
            <div style="font-size:var(--text-xs); color:var(--text-secondary);">
              {fmt(r.stars || 0)} stars · Health: {r.health?.toFixed(0)} · {r.language || '—'}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {trends.categories && trends.categories.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Category Momentum</h2></div>
      <div class="grid-3">
        {trends.categories.map((c: any) => (
          <div class="card" style="padding:var(--sp-5);">
            <div style="font-weight:600; font-size:var(--text-sm);">{c.category || c.name}</div>
            {c.momentum && <div style="font-size:var(--text-xs); color:var(--text-secondary); margin-top:var(--sp-2);">Momentum: {c.momentum}</div>}
            {c.count && <div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--sp-1);">{c.count} projects</div>}
          </div>
        ))}
      </div>
    </section>
  )}
</Layout>
