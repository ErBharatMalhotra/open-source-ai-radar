---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';
import { loadRepoHistory } from '../lib/history';

const base = import.meta.env.BASE_URL;
let repos: any[] = [];
const repoHistory = loadRepoHistory();
try {
  const data = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'projects-index.json'), 'utf-8'));
  repos = (data.projects || []).sort((a: any, b: any) => (b.radar_score || 0) - (a.radar_score || 0));
} catch {}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}
function scoreClass(s: number): string {
  if (s >= 75) return 'score-high';
  if (s >= 50) return 'score-mid';
  return 'score-low';
}
function momentumState(v: number): string {
  if (v >= 75) return 'breakout';
  if (v >= 60) return 'accelerating';
  if (v >= 40) return 'rising';
  if (v >= 20) return 'stable';
  return 'declining';
}
function momentumLabel(s: string): string {
  return ({ breakout: 'Breakout', accelerating: 'Accelerating', rising: 'Rising', stable: 'Stable', declining: 'Declining' } as any)[s] || '—';
}
function momentumIcon(s: string): string {
  const icons: Record<string, string> = {
    breakout: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l3-4 2 2 4-6 3 2"/><path d="M14 2v4h-4"/></svg>',
    accelerating: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l4-6 3 3 5-7"/></svg>',
    rising: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l3-4 3 2 6-8"/></svg>',
    stable: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><line x1="1" y1="10" x2="15" y2="10"/></svg>',
    declining: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l4 4 3-2 5 6"/></svg>',
  };
  return icons[s] || '';
}

function sparkline(stars: number[]): string {
  if (!stars || stars.length < 2) return '';
  const w = 60, h = 20, pad = 2;
  const min = Math.min(...stars), max = Math.max(...stars);
  const range = max - min || 1;
  const step = (w - pad * 2) / (stars.length - 1);
  const pts = stars.map((v, i) => {
    const x = pad + i * step;
    const y = h - pad - ((v - min) / range) * (h - pad * 2);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  const rising = stars[stars.length - 1] >= stars[0];
  const color = rising ? 'var(--green)' : 'var(--red)';
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" fill="none" xmlns="http://www.w3.org/2000/svg"><polyline points="${pts.join(' ')}" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
}

function repoUrl(r: any): string {
  const name = r.full_name || r.repo_full_name || '';
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}
---

<Layout title="Rankings" description={`Full rankings of ${repos.length.toLocaleString()} AI open-source projects by momentum score.`}>
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1>Project <span class="accent">Rankings</span></h1>
    <p>All {repos.length.toLocaleString()} tracked projects ranked by radar score</p>
  </section>

  <div class="section">
    <div class="search-box" id="searchBox">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" id="searchInput" placeholder="Search projects by name, description, topic, language..." aria-label="Search projects" />
    </div>

    <div class="filters" id="filters" style="margin-top:var(--sp-4);">
      <button class="filter-pill active" data-filter="all">All</button>
      <button class="filter-pill" data-filter="breakout">Breakout</button>
      <button class="filter-pill" data-filter="accelerating">Accelerating</button>
      <button class="filter-pill" data-filter="rising">Rising</button>
      <button class="filter-pill" data-filter="stable">Stable</button>
      <button class="filter-pill" data-filter="declining">Declining</button>
    </div>

    <div class="filters" style="margin-top:var(--sp-3); display:flex; flex-wrap:wrap; gap:var(--sp-2); align-items:center;">
      <label style="display:inline-flex; align-items:center; gap:var(--sp-2); font-size:var(--text-xs); color:var(--text-muted); background:var(--bg-surface); padding:var(--sp-1) var(--sp-3); border-radius:var(--radius); border:1px solid var(--border);">
        <span>Language:</span>
        <select id="languageSelect" style="background:transparent; color:var(--text); border:none; font-size:var(--text-xs); outline:none; cursor:pointer;">
          <option value="all" style="background:var(--bg-surface);">All</option>
        </select>
      </label>
      <label style="display:inline-flex; align-items:center; gap:var(--sp-2); font-size:var(--text-xs); color:var(--text-muted); background:var(--bg-surface); padding:var(--sp-1) var(--sp-3); border-radius:var(--radius); border:1px solid var(--border);">
        <span>License:</span>
        <select id="licenseSelect" style="background:transparent; color:var(--text); border:none; font-size:var(--text-xs); outline:none; cursor:pointer;">
          <option value="all" style="background:var(--bg-surface);">All</option>
        </select>
      </label>
      <button id="clearFilters" class="filter-pill" style="cursor:pointer; display:none;">✕ Clear filters</button>
    </div>

    <div id="resultCount" style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--sp-3);">Showing all {repos.length.toLocaleString()} projects (100 per page)</div>

    <div style="margin-top:var(--sp-4);">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Project</th>
              <th>Language</th>
              <th class="num">Stars</th>
              <th class="num">Score</th>
              <th>Trend</th>
              <th class="num">Velocity</th>
              <th>Momentum</th>
            </tr>
          </thead>
          <tbody id="repoTable">
            {repos.map((r: any, i: number) => {
              const state = momentumState(r.velocity || 0);
              const name = r.full_name || r.repo_full_name || '';
              return (
                <tr class="repo-row" data-search={`${name} ${r.description || ''} ${r.language || ''} ${r.category || ''}`.toLowerCase()} data-momentum={state} data-language={r.language || ''} data-license={r.license || ''}>
                  <td style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-muted);">{i + 1}</td>
                  <td>
                    <a href={repoUrl(r)} style="display:flex; align-items:center; gap:var(--sp-3); font-weight:600; color:var(--text); text-decoration:none;">
                      {r.owner_avatar
                        ? <img src={r.owner_avatar} alt="" width="24" height="24" style="width:24px; height:24px; border-radius:50%; object-fit:cover; flex-shrink:0;" loading="lazy" data-owner={name} referrerpolicy="no-referrer" />
                        : <span class="avatar-fallback" style="width:24px; height:24px; font-size:10px;">{(name.split('/')[0] || '?').replace(/[^a-zA-Z0-9]/g, '').substring(0, 2).toUpperCase() || '?'}</span>}
                      <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{name}</span>
                    </a>
                    {r.description && <div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px; max-width:400px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{r.description}</div>}
                  </td>
                  <td>{r.language && <span class="badge">{r.language}</span>}</td>
                  <td class="num">{fmt(r.stars || 0)}</td>
                  <td class="num"><span class={`score-pill ${scoreClass(r.radar_score)}`}>{r.radar_score?.toFixed(1)}</span></td>
                  <td><Fragment set:html={sparkline(repoHistory[name] || [])} /></td>
                  <td class="num">{r.velocity?.toFixed(0)}</td>
                  <td><span class={`momentum momentum-${state}`}><Fragment set:html={momentumIcon(state)} />{momentumLabel(state)}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <div class="pagination" style="display:flex; justify-content:center; align-items:center; gap:var(--sp-4); margin-top:var(--sp-6);">
      <button id="prevBtn" class="filter-pill" style="cursor:pointer;">← Previous</button>
      <span id="pageIndicator" style="font-size:var(--text-sm); color:var(--text-muted); font-family:var(--font-mono);">Page 1 of 1</span>
      <button id="nextBtn" class="filter-pill" style="cursor:pointer;">Next →</button>
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('searchInput') as HTMLInputElement;
  const rows = Array.from(document.querySelectorAll('.repo-row')) as HTMLElement[];
  const pills = document.querySelectorAll('.filter-pill[data-filter]');
  const countEl = document.getElementById('resultCount');
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const pageIndicator = document.getElementById('pageIndicator');
  const languageSelect = document.getElementById('languageSelect') as HTMLSelectElement;
  const licenseSelect = document.getElementById('licenseSelect') as HTMLSelectElement;
  const clearBtn = document.getElementById('clearFilters') as HTMLButtonElement;

  let activeFilter = 'all';
  let activeLanguage = 'all';
  let activeLicense = 'all';
  let currentPage = 1;
  const pageSize = 100;
  let filteredRows = rows;
  let searchTimer: any;

  // Dynamically populate language + license dropdowns with project counts
  function populateSelect(select: HTMLSelectElement | null, attr: string) {
    if (!select) return;
    const counts = new Map<string, number>();
    rows.forEach(r => {
      const v = (r.dataset as any)[attr] || '';
      if (!v || v === 'null' || v.toLowerCase() === 'none') return;
      counts.set(v, (counts.get(v) || 0) + 1);
    });
    const sorted = Array.from(counts.entries()).sort((a, b) => b[1] - a[1]).slice(0, 30);
    for (const [name, count] of sorted) {
      const opt = document.createElement('option');
      opt.value = name;
      opt.textContent = `${name} (${count.toLocaleString()})`;
      opt.style.background = 'var(--bg-surface)';
      select.appendChild(opt);
    }
  }
  populateSelect(languageSelect, 'language');
  populateSelect(licenseSelect, 'license');

  function updatePagination() {
    const totalPages = Math.ceil(filteredRows.length / pageSize) || 1;
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const start = (currentPage - 1) * pageSize;
    const end = start + pageSize;

    rows.forEach(r => (r.style.display = 'none'));
    filteredRows.slice(start, end).forEach(r => (r.style.display = ''));

    if (pageIndicator) pageIndicator.textContent = `Page ${currentPage} of ${totalPages}`;
    if (prevBtn) {
      prevBtn.style.opacity = currentPage === 1 ? '0.4' : '1';
      prevBtn.style.pointerEvents = currentPage === 1 ? 'none' : 'auto';
    }
    if (nextBtn) {
      nextBtn.style.opacity = currentPage === totalPages ? '0.4' : '1';
      nextBtn.style.pointerEvents = currentPage === totalPages ? 'none' : 'auto';
    }

    const hasFilter = activeFilter !== 'all' || activeLanguage !== 'all' || activeLicense !== 'all' || !!(input?.value || '').trim();
    if (clearBtn) clearBtn.style.display = hasFilter ? 'inline-block' : 'none';

    if (countEl) {
      const total = rows.length;
      const showing = hasFilter
        ? `Showing ${filteredRows.length.toLocaleString()} of ${total.toLocaleString()} projects`
        : `Showing all ${total.toLocaleString()} projects (100 per page)`;
      countEl.textContent = showing;
    }
  }

  function applyFilter() {
    const q = (input?.value || '').toLowerCase().trim();
    filteredRows = rows.filter(row => {
      const text = row.dataset.search || '';
      const momentum = row.dataset.momentum || '';
      const lang = row.dataset.language || '';
      const lic = row.dataset.license || '';
      const matchText = !q || text.includes(q);
      const matchMomentum = activeFilter === 'all' || momentum === activeFilter;
      const matchLang = activeLanguage === 'all' || lang === activeLanguage;
      const matchLic = activeLicense === 'all' || lic === activeLicense;
      return matchText && matchMomentum && matchLang && matchLic;
    });
    currentPage = 1;
    updatePagination();
  }

  input?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(applyFilter, 150);
  });

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = (pill as HTMLElement).dataset.filter || 'all';
      applyFilter();
    });
  });

  languageSelect?.addEventListener('change', () => { activeLanguage = languageSelect.value; applyFilter(); });
  licenseSelect?.addEventListener('change', () => { activeLicense = licenseSelect.value; applyFilter(); });
  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    if (languageSelect) languageSelect.value = 'all';
    if (licenseSelect) licenseSelect.value = 'all';
    activeLanguage = 'all';
    activeLicense = 'all';
    activeFilter = 'all';
    pills.forEach(p => p.classList.toggle('active', (p as HTMLElement).dataset.filter === 'all'));
    applyFilter();
  });

  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      updatePagination();
      window.scrollTo({ top: 350, behavior: 'smooth' });
    }
  });

  nextBtn?.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredRows.length / pageSize) || 1;
    if (currentPage < totalPages) {
      currentPage++;
      updatePagination();
      window.scrollTo({ top: 350, behavior: 'smooth' });
    }
  });

  // Initial render — show only page 1
  updatePagination();
</script>
