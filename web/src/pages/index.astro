---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
const dataPath = join(process.cwd(), '..', 'data', 'exports', 'stats.json');
const topPath = join(process.cwd(), '..', 'data', 'exports', 'top.json');
const trendsPath = join(process.cwd(), '..', 'data', 'exports', 'trends.json');

let stats = { total_repos: 0, total_stars: 0, top_languages: {} };
let topRepos: any[] = [];
let trends: any = {};

try {
  stats = JSON.parse(readFileSync(dataPath, 'utf-8'));
  const topData = JSON.parse(readFileSync(topPath, 'utf-8'));
  topRepos = topData.repos?.slice(0, 50) || [];
} catch (e) {
  console.error('Could not load data files');
}

try {
  trends = JSON.parse(readFileSync(trendsPath, 'utf-8'));
} catch (e) {
  // No trends data yet
}

function formatStars(n: number): string {
  if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
  if (n >= 1000) return (n / 1000).toFixed(1) + 'k';
  return n.toString();
}

function scoreClass(s: number): string {
  if (s >= 75) return 'score-high';
  if (s >= 50) return 'score-mid';
  return 'score-low';
}

function formatGrowth(n: number): string {
  if (n > 0) return `+${formatStars(n)}`;
  if (n < 0) return formatStars(n);
  return '0';
}

function repoUrl(fullName: string): string {
  const [owner, repo] = fullName.split('/');
  return `${base}project/${owner}/${repo}`;
}
---

<Layout title="Home">
  <div class="hero">
    <h1>📡 Open Source <span>AI Radar</span></h1>
    <p>Discover what is becoming important before everyone else does.</p>
  </div>

  <div class="stats-bar">
    <div class="stat">
      <div class="stat-value">{stats.total_repos?.toLocaleString() || '0'}</div>
      <div class="stat-label">Projects Tracked</div>
    </div>
    <div class="stat">
      <div class="stat-value">{formatStars(stats.total_stars || 0)}</div>
      <div class="stat-label">Total Stars</div>
    </div>
    <div class="stat">
      <div class="stat-value">{Object.keys(stats.top_languages || {}).length}</div>
      <div class="stat-label">Languages</div>
    </div>
    {trends.categories && (
      <div class="stat">
        <div class="stat-value">{trends.categories.length}</div>
        <div class="stat-label">Categories</div>
      </div>
    )}
  </div>

  <!-- Anomalies -->
  {trends.anomalies && trends.anomalies.length > 0 ? (
    <div class="section-header">
      <h2>🚨 Anomalies Detected</h2>
      <a href={`${base}trends`}>View all →</a>
    </div>
    <div class="anomaly-cards">
      {trends.anomalies.slice(0, 4).map((a: any) => (
        <div class="anomaly-card">
          <div class="anomaly-type">
            {a.trend_direction === 'up' ? '📈' : '📉'} {a.trend_direction === 'up' ? 'Score Jump' : 'Score Drop'}
          </div>
          <a class="anomaly-name" href={repoUrl(a.repo_full_name)}>{a.repo_full_name}</a>
          <div class="anomaly-change">
            <span class={a.score_change > 0 ? 'positive' : 'negative'}>
              {a.score_change > 0 ? '+' : ''}{a.score_change?.toFixed(1)} pts
            </span>
            <span class="anomaly-stars">⭐ {formatStars(a.stars || 0)}</span>
          </div>
        </div>
      ))}
    </div>
  ) : null}

  <!-- Rising Stars -->
  {trends.rising_stars && trends.rising_stars.length > 0 ? (
    <div class="section-header">
      <h2>🔥 Rising Stars</h2>
      <a href={`${base}trends`}>View all →</a>
    </div>
    <div class="trend-cards">
      {trends.rising_stars.slice(0, 6).map((repo: any) => (
        <a class="trend-card" href={repoUrl(repo.repo_full_name)}>
          <div class="trend-card-header">
            <span class="trend-name">{repo.repo_full_name}</span>
            <span class={`score-badge ${scoreClass(repo.velocity)}`}>
              {repo.velocity?.toFixed(0)}
            </span>
          </div>
          <div class="trend-card-stats">
            <span>⭐ {formatStars(repo.stars || 0)}</span>
            <span>📊 {repo.radar_score?.toFixed(1)}</span>
            {repo.language && <span>{repo.language}</span>}
          </div>
        </a>
      ))}
    </div>
  ) : null}

  <!-- Breakout Candidates -->
  {trends.breakout_candidates && trends.breakout_candidates.length > 0 ? (
    <div class="section-header">
      <h2>🔥 Breakout Candidates</h2>
      <a href={`${base}breakouts`}>View all →</a>
    </div>
    <div class="trend-cards">
      {trends.breakout_candidates.slice(0, 4).map((repo: any) => (
        <a class="trend-card breakout" href={repoUrl(repo.repo_full_name)}>
          <div class="trend-card-header">
            <span class="trend-name">{repo.repo_full_name}</span>
            <span class="breakout-badge">
              {repo.breakout_score?.toFixed(0)}
            </span>
          </div>
          <div class="trend-card-stats">
            <span>⭐ {formatStars(repo.stars || 0)}</span>
            <span>🚀 {repo.velocity?.toFixed(0)} vel</span>
            <span>📈 {repo.star_growth_acceleration?.toFixed(1)}x accel</span>
          </div>
        </a>
      ))}
    </div>
  ) : null}

  <!-- Hidden Gems -->
  {trends.hidden_gems && trends.hidden_gems.length > 0 ? (
    <div class="section-header">
      <h2>💎 Hidden Gems</h2>
      <a href={`${base}trends`}>View all →</a>
    </div>
    <div class="trend-cards">
      {trends.hidden_gems.slice(0, 6).map((repo: any) => (
        <a class="trend-card gem" href={repoUrl(repo.repo_full_name)}>
          <div class="trend-card-header">
            <span class="trend-name">{repo.repo_full_name}</span>
            <span class="gem-badge">
              {repo.velocity?.toFixed(0)}
            </span>
          </div>
          <div class="trend-card-stats">
            <span>⭐ {formatStars(repo.stars || 0)}</span>
            <span>💚 Health: {repo.health?.toFixed(0)}</span>
            {repo.language && <span>{repo.language}</span>}
          </div>
        </a>
      ))}
    </div>
  ) : null}

  <!-- Top Projects -->
  <div class="section-header">
    <h2>🏆 Top Projects by Radar Score</h2>
    <a href={`${base}top`}>View all →</a>
  </div>

  <table class="repo-table">
    <thead>
      <tr>
        <th class="rank">#</th>
        <th>Project</th>
        <th class="hide-mobile">Lang</th>
        <th class="num">Stars</th>
        <th class="num">Score</th>
        <th class="hide-mobile">Impact</th>
        <th class="hide-mobile">Velocity</th>
        <th class="hide-mobile">Health</th>
      </tr>
    </thead>
    <tbody>
      {topRepos.map((repo: any, i: number) => (
        <tr>
          <td class="rank">{i + 1}</td>
          <td>
            <a class="repo-name" href={repoUrl(repo.full_name)}>
              {repo.full_name}
            </a>
            {repo.description && <div class="repo-desc">{repo.description}</div>}
          </td>
          <td class="hide-mobile">
            {repo.language && <span class="repo-lang">{repo.language}</span>}
          </td>
          <td class="num">{formatStars(repo.stars || 0)}</td>
          <td class="num">
            <span class={`score-badge ${scoreClass(repo.radar_score)}`}>
              {repo.radar_score?.toFixed(1)}
            </span>
          </td>
          <td class="hide-mobile num">
            {repo.impact?.toFixed(0)}
            <div class="axis-bar"><div class="axis-fill" style={`width:${repo.impact}%`}></div></div>
          </td>
          <td class="hide-mobile num">
            {repo.velocity?.toFixed(0)}
            <div class="axis-bar"><div class="axis-fill" style={`width:${repo.velocity}%`}></div></div>
          </td>
          <td class="hide-mobile num">
            {repo.health?.toFixed(0)}
            <div class="axis-bar"><div class="axis-fill" style={`width:${repo.health}%`}></div></div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="section-header">
    <h2>🚀 Fastest Growing</h2>
    <a href={`${base}trending`}>View all →</a>
  </div>

  <div style="text-align:center; padding:2rem; color:var(--text-dim)">
    <a href={`${base}trending`} style="color:var(--accent-light); text-decoration:none;">
      Explore trending projects →
    </a>
  </div>
</Layout>

<style>
  .trend-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .trend-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.1s;
  }

  .trend-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .trend-card.gem {
    border-left: 3px solid var(--green);
  }

  .trend-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .trend-name {
    font-weight: 600;
    color: var(--accent-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
  }

  .score-badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.8rem;
    background: rgba(108, 92, 231, 0.15);
    color: var(--accent-light);
  }

  .gem-badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.8rem;
    background: rgba(0, 210, 160, 0.15);
    color: var(--green);
  }

  .trend-card-stats {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .anomaly-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .anomaly-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--orange);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .trend-card.breakout {
    border-left: 3px solid var(--green);
  }

  .breakout-badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.8rem;
    background: rgba(0, 210, 160, 0.15);
    color: var(--green);
  }

  .anomaly-type {
    font-size: 0.75rem;
    color: var(--orange);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .anomaly-name {
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .anomaly-name:hover {
    text-decoration: underline;
  }

  .anomaly-change {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .anomaly-change .positive { color: var(--green); font-weight: 600; }
  .anomaly-change .negative { color: var(--red); font-weight: 600; }
  .anomaly-stars { color: var(--text-dim); }

  @media (max-width: 768px) {
    .trend-cards, .anomaly-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
