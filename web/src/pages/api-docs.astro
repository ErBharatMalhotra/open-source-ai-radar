---
import Layout from '../layouts/Layout.astro';

const siteUrl = "https://erbharatmalhotra.github.io/open-source-ai-radar";

const endpoints = [
  { method: "GET", path: "/data/exports/stats.json", desc: "Aggregate statistics" },
  { method: "GET", path: "/data/exports/top.json", desc: "Top-ranked projects" },
  { method: "GET", path: "/data/exports/trending.json", desc: "Trending projects" },
  { method: "GET", path: "/data/exports/trends.json", desc: "Trends, anomalies, rising stars" },
  { method: "GET", path: "/data/exports/breakouts.json", desc: "Breakout candidates" },
  { method: "GET", path: "/data/exports/categories.json", desc: "Category listings" },
  { method: "GET", path: "/data/exports/category-intelligence.json", desc: "Category momentum data" },
  { method: "GET", path: "/data/exports/projects-index.json", desc: "Full project search index" },
  { method: "GET", path: "/data/exports/projects/{owner}__{repo}.json", desc: "Individual project detail" },
  { method: "GET", path: "/data/exports/history/{owner}__{repo}.json", desc: "Project snapshot history" },
  { method: "GET", path: "/data/exports/feed.xml", desc: "RSS feed" },
];
---

<Layout title="API" description="REST API for Open Source AI Radar data.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1><span class="accent">API</span> Documentation</h1>
    <p>Access all radar data via public JSON endpoints</p>
  </section>

  <section class="section">
    <div class="card" style="padding:var(--sp-6);">
      <h2 style="font-size:var(--text-lg); margin-bottom:var(--sp-4);">Base URL</h2>
      <code style="display:block; padding:var(--sp-3) var(--sp-4); background:var(--bg); border-radius:var(--radius-sm); font-family:var(--font-mono); font-size:var(--text-sm); color:var(--accent);">{siteUrl}</code>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Endpoints</h2></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Method</th>
            <th>Endpoint</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {endpoints.map(ep => (
            <tr>
              <td><span class="badge" style="color:var(--green);">{ep.method}</span></td>
              <td><code style="font-family:var(--font-mono); font-size:var(--text-xs);">{ep.path}</code></td>
              <td style="color:var(--text-secondary);">{ep.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="card" style="padding:var(--sp-6);">
      <h2 style="font-size:var(--text-lg); margin-bottom:var(--sp-4);">Usage Example</h2>
      <code style="display:block; padding:var(--sp-4); background:var(--bg); border-radius:var(--radius-sm); font-family:var(--font-mono); font-size:var(--text-sm); white-space:pre-wrap; overflow-x:auto;"># Fetch top projects
curl {siteUrl}/data/exports/top.json

# Fetch project detail
curl {siteUrl}/data/exports/projects/facebook__llama.json

# RSS feed
curl {siteUrl}/data/exports/feed.xml</code>
    </div>
  </section>
</Layout>
