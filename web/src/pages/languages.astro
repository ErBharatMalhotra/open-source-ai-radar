---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
let stats: any = { top_languages: {} };
try { stats = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'stats.json'), 'utf-8')); } catch {}

const languages = Object.entries(stats.top_languages || {})
  .sort((a: any, b: any) => b[1] - a[1]);
---

<Layout title="Languages" description="Programming languages used across tracked AI projects.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1><span class="accent">Languages</span></h1>
    <p>{languages.length} languages across all tracked projects</p>
  </section>

  <div class="grid-3">
    {languages.map(([lang, count]: any, i: number) => (
      <div class="card" style="padding:var(--sp-5);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <span style="font-weight:600; font-size:var(--text-sm);">{lang}</span>
          <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-muted);">#{i + 1}</span>
        </div>
        <div style="font-size:var(--text-xs); color:var(--text-secondary); margin-top:var(--sp-2);">{count} projects</div>
        <div class="bar" style="margin-top:var(--sp-3);">
          <div class="bar-fill" style={`width:${Math.min(100, (count / (languages[0]?.[1] || 1)) * 100)}%`}></div>
        </div>
      </div>
    ))}
  </div>
</Layout>
