---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: object;
  ogImage?: string;
}

const {
  title,
  description = "Discover what is becoming important before everyone else does. Track 7,000+ AI open-source projects with velocity scoring, anomaly detection, and breakout predictions.",
  canonical,
  jsonLd,
  ogImage,
} = Astro.props;

// GoatCounter analytics — create a free account at goatcounter.com and put
// your site code here (e.g. "example"). Left empty = analytics disabled.
const GOATCOUNTER_SITE = import.meta.env.PUBLIC_GOATCOUNTER_SITE || "";

const base = import.meta.env.BASE_URL;
const siteUrl = "https://erbharatmalhotra.github.io";
const fullUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${base}`;
const socialImage = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}${base}favicon.svg`;

const navItems = [
  { href: `${base}`, label: "Home" },
  { href: `${base}top`, label: "Rankings" },
  { href: `${base}trending`, label: "Trending" },
  { href: `${base}breakouts`, label: "Breakouts" },
  { href: `${base}categories`, label: "Categories" },
  { href: `${base}digests`, label: "Digests" },
  { href: `${base}api-docs`, label: "API" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Open Source AI Radar</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles/tokens.css`} />
    <link rel="stylesheet" href={`${base}styles/base.css`} />
    <link rel="stylesheet" href={`${base}styles/components.css`} />
    <meta property="og:title" content={`${title} — Open Source AI Radar`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Open Source AI Radar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Open Source AI Radar`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {GOATCOUNTER_SITE && (
      <script is:inline data-goatcounter={`https://${GOATCOUNTER_SITE}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
    )}
  
    <style is:global>
      /* Avatar fallback - shows initials when image fails */
      .avatar-fallback {
        width: 32px; height: 32px; border-radius: 50%;
        background: var(--accent); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 600; flex-shrink: 0;
      }
      img[data-failed="true"] { display: none !important; }
    </style>
  </head>
  <body>
    <nav class="nav" role="navigation" aria-label="Main">
      <div class="nav-inner">
        <a href={base} class="nav-logo" aria-label="Open Source AI Radar home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 8 4"/>
            <path d="M5 19.5C5.5 18 6 15 6 12c0-3.5 2.5-6 6-6 2 0 3.5 1 4.5 2.5"/>
            <path d="M12 12a3 3 0 1 0 0 6c1.5 0 3-1 3-3 0-1-.5-2-1.5-3"/>
            <circle cx="12" cy="12" r="1"/>
          </svg>
          <span>AI Radar</span>
        </a>

        <button class="nav-mobile-toggle" aria-label="Toggle menu" aria-expanded="false" id="navToggle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <div class="nav-links" id="navLinks" role="menubar">
          {navItems.map(item => (
            <a href={item.href} role="menuitem"
               aria-current={Astro.url.pathname === item.href || Astro.url.pathname === item.href + "/" ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <main class="page">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>Open Source AI Radar</span>
        <div class="footer-links">
          <a href={`${base}top`}>Rankings</a>
          <a href={`${base}categories`}>Categories</a>
          <a href={`${base}api-docs`}>API</a>
          <a href="https://github.com/ErBharatMalhotra/open-source-ai-radar" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      if (toggle && links) {
        toggle.addEventListener('click', () => {
          const open = links.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      }
    </script>
  
    <script>
      (function() {
        function replaceWithFallback(img) {
          if (!img.parentNode) return;
          var name = img.getAttribute('data-owner') || '?';
          var initials = name.split('/')[0].replace(/[^a-zA-Z0-9]/g, '').substring(0, 2).toUpperCase() || '?';
          var fallback = document.createElement('div');
          fallback.className = 'avatar-fallback';
          fallback.textContent = initials;
          fallback.style.width = img.getAttribute('width') || '32px';
          fallback.style.height = img.getAttribute('height') || '32px';
          img.parentNode.replaceChild(fallback, img);
        }
        document.addEventListener('error', function(e) {
          var t = e.target;
          if (t && t.tagName === 'IMG' && t.hasAttribute('data-owner')) {
            replaceWithFallback(t);
          }
        }, true);
        document.querySelectorAll('img[data-owner]').forEach(function(img) {
          img.referrerPolicy = 'no-referrer';
          if (img.complete && img.naturalWidth === 0 && img.getAttribute('src')) {
            replaceWithFallback(img);
          }
        });
      })();
    </script>
  </body>
</html>
