---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Discover what is becoming important before everyone else does." } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Open Source AI Radar</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a href={base} class="logo">
          <span class="logo-icon">📡</span>
          <span class="logo-text">Open Source AI Radar</span>
        </a>
        <div class="nav-links">
          <a href={`${base}trends`}>Trends</a>
          <a href={`${base}trending`}>Trending</a>
          <a href={`${base}top`}>Top Projects</a>
          <a href={`${base}languages`}>Languages</a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <p>Open Source AI Radar — Discover what is becoming important</p>
        <p class="footer-sub">Automated intelligence from GitHub. Updated daily.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0f;
    --bg-card: #12121a;
    --bg-hover: #1a1a25;
    --border: #1e1e2e;
    --text: #e0e0e8;
    --text-dim: #8888a0;
    --accent: #6c5ce7;
    --accent-light: #a29bfe;
    --green: #00d2a0;
    --orange: #fdcb6e;
    --red: #ff6b6b;
    --radius: 8px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
  }

  nav {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    background: rgba(10, 10, 15, 0.9);
    backdrop-filter: blur(10px);
    z-index: 100;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .logo-icon { font-size: 1.3rem; }

  .nav-links { display: flex; gap: 1.5rem; }
  .nav-links a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text); }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: 70vh;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .footer-sub { margin-top: 0.25rem; opacity: 0.6; font-size: 0.8rem; }

  .hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .hero h1 span { color: var(--accent-light); }
  .hero p {
    color: var(--text-dim);
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .stats-bar {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin: 2rem 0;
    padding: 1.25rem;
    background: var(--bg-card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .stat { text-align: center; }
  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-light);
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 2.5rem 0 1rem;
  }
  .section-header h2 {
    font-size: 1.3rem;
    font-weight: 700;
  }
  .section-header a {
    color: var(--accent-light);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .repo-table {
    width: 100%;
    border-collapse: collapse;
  }
  .repo-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    border-bottom: 1px solid var(--border);
  }
  .repo-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .repo-table tr:hover { background: var(--bg-hover); }
  .repo-table .rank {
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
    width: 2rem;
  }
  .repo-name {
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
  }
  .repo-name:hover { text-decoration: underline; }
  .repo-desc {
    color: var(--text-dim);
    font-size: 0.8rem;
    margin-top: 0.15rem;
    max-width: 400px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .repo-lang {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background: var(--bg-hover);
    border-radius: 4px;
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .score-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .score-high { background: rgba(0, 210, 160, 0.15); color: var(--green); }
  .score-mid { background: rgba(253, 203, 110, 0.15); color: var(--orange); }
  .score-low { background: rgba(255, 107, 107, 0.1); color: var(--red); }

  .axis-bar {
    height: 4px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
    width: 60px;
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
  }
  .axis-fill {
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 1.8rem; }
    .stats-bar { flex-wrap: wrap; gap: 1.5rem; }
    .repo-table .hide-mobile { display: none; }
    .nav-links { gap: 1rem; }
  }
</style>
