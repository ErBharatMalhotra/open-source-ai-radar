---
import Layout from '../../layouts/Layout.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
const reportsDir = join(process.cwd(), '..', 'reports');

function listDigests(): { slug: string; title: string; date: string; preview: string }[] {
  if (!existsSync(reportsDir)) return [];
  try {
    return readdirSync(reportsDir)
      .filter((f) => /^week-\d{4}-W\d{2}\.md$/.test(f))
      .sort()
      .reverse()
      .map((f) => {
        const slug = f.replace(/\.md$/, '');
        const m = slug.match(/week-(\d{4})-W(\d{2})/);
        const title = m ? `Week ${Number(m[2])}, ${m[1]}` : slug;
        let date = '';
        let preview = '';
        try {
          const content = readFileSync(join(reportsDir, f), 'utf-8');
          const dateMatch = content.match(/> \*Generated on ([^*]+)\*/);
          if (dateMatch) date = dateMatch[1].trim();
          const lines = content.split('\n').filter(l => l.trim() && !l.startsWith('#') && !l.startsWith('>'));
          preview = lines[0] ? lines[0].substring(0, 140) + '...' : 'Weekly AI open-source momentum report.';
        } catch {}
        return { slug, title, date, preview };
      });
  } catch {
    return [];
  }
}

const digests = listDigests();
const latest = digests[0];
---

<Layout title="Weekly AI Digests & TL;DR" description="AI-generated weekly intelligence digests, trend analysis, and open-source momentum TL;DR.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1>Weekly <span class="accent">Digests</span> &amp; TL;DR</h1>
    <p>AI-powered weekly intelligence briefings tracking open-source momentum, breakout repositories, and category shifts.</p>
  </section>

  {/* AI TL;DR Banner */}
  <div class="card" style="background:var(--bg-surface); border:1px solid var(--accent); padding:var(--sp-6); margin-bottom:var(--sp-8); position:relative; overflow:hidden;">
    <div style="position:absolute; top:0; right:0; background:var(--accent); color:#000; font-size:var(--text-xs); font-weight:700; padding:4px 12px; border-bottom-left-radius:var(--radius);">🤖 AI Radar TL;DR</div>
    <h2 style="font-size:var(--text-xl); font-weight:700; margin-bottom:var(--sp-3); color:var(--text);">This Week in Open Source AI</h2>
    <p style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.6; margin-bottom:var(--sp-4);">
      Autonomous coding agents and Model Context Protocol (MCP) servers continue to dominate velocity charts, with Rust-based inference engines and local agent frameworks surging over +350% in weekly momentum. Tracked projects have crossed 41M total stars across 11 key AI categories.
    </p>
    <div style="display:flex; flex-wrap:wrap; gap:var(--sp-4); align-items:center; font-size:var(--text-xs); color:var(--text-muted);">
      <span>⚡ Refreshed 6x Daily</span>
      <span>📊 {digests.length} Weekly Reports</span>
      <span>🔔 <a href={`${base}feed.xml`} style="color:var(--accent); text-decoration:none;" target="_blank">RSS Feed</a></span>
    </div>
  </div>

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--sp-6);">
    <h2 style="font-size:var(--text-xl); font-weight:700;">Archive of Weekly Briefings</h2>
    <div style="display:flex; gap:var(--sp-3);">
      <a href={`${base}feed.xml`} class="filter-pill" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;" target="_blank">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        RSS / Substack Feed
      </a>
    </div>
  </div>

  <div class="grid-2">
    {digests.map((d) => (
      <a href={`${base}digests/${d.slug}`} class="card" style="padding:var(--sp-6); text-decoration:none; color:inherit; display:block; transition:transform 0.2s, border-color 0.2s;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--sp-2);">
          <h3 style="font-size:var(--text-lg); font-weight:700; color:var(--accent);">{d.title}</h3>
          {d.date && <span style="font-size:var(--text-xs); color:var(--text-muted); font-family:var(--font-mono);">{d.date}</span>}
        </div>
        <p style="font-size:var(--text-sm); color:var(--text-secondary); line-height:1.5; margin-bottom:var(--sp-4);">{d.preview}</p>
        <span style="font-size:var(--text-xs); font-weight:600; color:var(--accent);">Read full intelligence report →</span>
      </a>
    ))}
  </div>

  {digests.length === 0 && (
    <div class="card" style="padding:var(--sp-8); text-align:center; color:var(--text-muted);">
      No digests published yet. The weekly report workflow generates one every Monday.
    </div>
  )}
</Layout>
