---
import Layout from '../layouts/Layout.astro';

const siteUrl = "https://erbharatmalhotra.github.io/open-source-ai-radar";

const endpoints = [
  { method: "GET", path: "/data/exports/stats.json", desc: "Aggregate statistics" },
  { method: "GET", path: "/data/exports/top.json", desc: "Top-ranked projects" },
  { method: "GET", path: "/data/exports/trending.json", desc: "Trending projects" },
  { method: "GET", path: "/data/exports/trends.json", desc: "Trends, anomalies, rising stars" },
  { method: "GET", path: "/data/exports/breakouts.json", desc: "Breakout candidates" },
  { method: "GET", path: "/data/exports/categories.json", desc: "Category listings" },
  { method: "GET", path: "/data/exports/category-intelligence.json", desc: "Category momentum data" },
  { method: "GET", path: "/data/exports/projects-index.json", desc: "Full project search index" },
  { method: "GET", path: "/data/exports/projects/{owner}__{repo}.json", desc: "Individual project detail" },
  { method: "GET", path: "/data/exports/history/{owner}__{repo}.json", desc: "Project snapshot history" },
  { method: "GET", path: "/data/exports/feed.xml", desc: "RSS feed" },
];
---

<Layout title="API" description="REST API for Open Source AI Radar data.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1><span class="accent">API</span> Documentation</h1>
    <p>Access all radar data via public JSON endpoints</p>
  </section>

  <section class="section">
    <div class="card" style="padding:var(--sp-6);">
      <h2 style="font-size:var(--text-lg); margin-bottom:var(--sp-4);">Base URL</h2>
      <code style="display:block; padding:var(--sp-3) var(--sp-4); background:var(--bg); border-radius:var(--radius-sm); font-family:var(--font-mono); font-size:var(--text-sm); color:var(--accent);">{siteUrl}</code>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>README Badges</h2></div>
    <div class="card" style="padding:var(--sp-6); margin-bottom:var(--sp-4);">
      <p style="color:var(--text-secondary); font-size:var(--text-sm); margin-bottom:var(--sp-4);">
        Show your project's live Radar Score in your README — it updates automatically every day.
        Replace <code style="font-family:var(--font-mono);">OWNER__REPO</code> with your GitHub owner and repo joined by two underscores
        (e.g. <code style="font-family:var(--font-mono);">BerriAI__litellm</code>).
      </p>
      <h3 style="font-size:var(--text-sm); font-weight:600; color:var(--accent); margin-bottom:var(--sp-2);">Score badge</h3>
      <pre style="padding:var(--sp-4); background:var(--bg); border-radius:var(--radius-sm); font-family:var(--font-mono); font-size:var(--text-xs); white-space:pre-wrap; overflow-x:auto; margin-bottom:var(--sp-4);">![AI Radar Score](https://erbharatmalhotra.github.io/open-source-ai-radar/api/badges/OWNER__REPO/score.svg)</pre>
      <p style="margin-bottom:var(--sp-2);"><img src="/open-source-ai-radar/api/badges/BerriAI__litellm/score.svg" alt="score badge preview" style="height:20px;" /></p>
      <h3 style="font-size:var(--text-sm); font-weight:600; color:var(--accent); margin-bottom:var(--sp-2);">Velocity badge</h3>
      <pre style="padding:var(--sp-4); background:var(--bg); border-radius:var(--radius-sm); font-family:var(--font-mono); font-size:var(--text-xs); white-space:pre-wrap; overflow-x:auto;">![AI Radar Velocity](https://erbharatmalhotra.github.io/open-source-ai-radar/api/badges/OWNER__REPO/velocity.svg)</pre>
      <p style="margin-top:var(--sp-2);"><img src="/open-source-ai-radar/api/badges/BerriAI__litellm/velocity.svg" alt="velocity badge preview" style="height:20px;" /></p>
    </div>
    <div class="card" style="padding:var(--sp-6);">
      <h3 style="font-size:var(--text-sm); font-weight:600; margin-bottom:var(--sp-2);">Available badges</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Badge</th><th>Shows</th></tr></thead>
          <tbody>
            <tr><td><code style="font-family:var(--font-mono); font-size:var(--text-xs);">score.svg</code></td><td style="color:var(--text-secondary);">Live radar score, colored by tier</td></tr>
            <tr><td><code style="font-family:var(--font-mono); font-size:var(--text-xs);">velocity.svg</code></td><td style="color:var(--text-secondary);">7-day star velocity</td></tr>
            <tr><td><code style="font-family:var(--font-mono); font-size:var(--text-xs);">stars.svg</code></td><td style="color:var(--text-secondary);">Total star count</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top:var(--sp-4); font-size:var(--text-xs); color:var(--text-muted);">Ranked at the top of your category? Your score badge is a great way to show it off.</p>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Endpoints</h2></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Method</th>
            <th>Endpoint</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {endpoints.map(ep => (
            <tr>
              <td><span class="badge" style="color:var(--green);">{ep.method}</span></td>
              <td><code style="font-family:var(--font-mono); font-size:var(--text-xs);">{ep.path}</code></td>
              <td style="color:var(--text-secondary);">{ep.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="card" style="padding:var(--sp-6);">
      <h2 style="font-size:var(--text-lg); margin-bottom:var(--sp-4);">Usage Example</h2>
      <code style="display:block; padding:var(--sp-4); background:var(--bg); border-radius:var(--radius-sm); font-family:var(--font-mono); font-size:var(--text-sm); white-space:pre-wrap; overflow-x:auto;"># Fetch top projects
curl {siteUrl}/data/exports/top.json

# Fetch project detail
curl {siteUrl}/data/exports/projects/facebook__llama.json

# RSS feed
curl {siteUrl}/data/exports/feed.xml</code>
    </div>
  </section>
</Layout>
