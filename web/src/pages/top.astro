---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const base = import.meta.env.BASE_URL;
let repos: any[] = [];
try {
  const data = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'projects-index.json'), 'utf-8'));
  repos = (data.projects || []).sort((a: any, b: any) => (b.radar_score || 0) - (a.radar_score || 0));
} catch {}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}
function scoreClass(s: number): string {
  if (s >= 75) return 'score-high';
  if (s >= 50) return 'score-mid';
  return 'score-low';
}
function momentumState(v: number): string {
  if (v >= 60) return 'accelerating';
  if (v >= 40) return 'rising';
  if (v >= 20) return 'stable';
  return 'declining';
}
function momentumLabel(s: string): string {
  return ({ accelerating: 'Accelerating', rising: 'Rising', stable: 'Stable', declining: 'Declining' } as any)[s] || '—';
}
function momentumIcon(s: string): string {
  const icons: Record<string, string> = {
    accelerating: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l4-6 3 3 5-7"/></svg>',
    rising: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l3-4 3 2 6-8"/></svg>',
    stable: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><line x1="1" y1="10" x2="15" y2="10"/></svg>',
    declining: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l4 4 3-2 5 6"/></svg>',
  };
  return icons[s] || '';
}
function repoUrl(r: any): string {
  const name = r.full_name || r.repo_full_name || '';
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}
---

<Layout title="Rankings" description="Full rankings of {repos.length} AI open-source projects by momentum score.">
  <section class="hero-editorial" style="padding-bottom:var(--sp-8);">
    <h1>Project <span class="accent">Rankings</span></h1>
    <p>All {repos.length.toLocaleString()} tracked projects ranked by radar score</p>
  </section>

  <div class="section">
    <div class="search-box" id="searchBox">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" id="searchInput" placeholder="Search projects..." aria-label="Search projects" />
    </div>

    <div class="filters" id="filters">
      <button class="filter-pill active" data-filter="all">All</button>
      <button class="filter-pill" data-filter="accelerating">Accelerating</button>
      <button class="filter-pill" data-filter="rising">Rising</button>
      <button class="filter-pill" data-filter="stable">Stable</button>
      <button class="filter-pill" data-filter="declining">Declining</button>
    </div>

    <div id="resultCount" style="font-size:var(--text-xs); color:var(--text-muted); margin-top:var(--sp-3);">Showing all {repos.length.toLocaleString()} projects</div>

    <div style="margin-top:var(--sp-4);">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Project</th>
              <th>Language</th>
              <th class="num">Stars</th>
              <th class="num">Score</th>
              <th class="num">Velocity</th>
              <th>Momentum</th>
            </tr>
          </thead>
          <tbody id="repoTable">
            {repos.map((r: any, i: number) => {
              const state = momentumState(r.velocity || 0);
              const name = r.full_name || r.repo_full_name || '';
              return (
                <tr class="repo-row" data-search={`${name} ${r.description || ''} ${r.language || ''} ${r.category || ''}`.toLowerCase()} data-momentum={state}>
                  <td style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-muted);">{i + 1}</td>
                  <td>
                    <a href={repoUrl(r)} style="font-weight:600; color:var(--text); text-decoration:none;">
                      {name}
                    </a>
                    {r.description && <div style="font-size:var(--text-xs); color:var(--text-muted); margin-top:2px; max-width:400px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{r.description}</div>}
                  </td>
                  <td>{r.language && <span class="badge">{r.language}</span>}</td>
                  <td class="num">{fmt(r.stars || 0)}</td>
                  <td class="num"><span class={`score-pill ${scoreClass(r.radar_score)}`}>{r.radar_score?.toFixed(1)}</span></td>
                  <td class="num">{r.velocity?.toFixed(0)}</td>
                  <td><span class={`momentum momentum-${state}`}><Fragment set:html={momentumIcon(state)} />{momentumLabel(state)}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('searchInput') as HTMLInputElement;
  const rows = document.querySelectorAll('.repo-row');
  const pills = document.querySelectorAll('.filter-pill');
  const countEl = document.getElementById('resultCount');
  let activeFilter = 'all';
  let activeCount = 0;

  function applyFilter() {
    const q = (input?.value || '').toLowerCase().trim();
    activeCount = 0;
    rows.forEach(row => {
      const r = row as HTMLElement;
      const text = r.dataset.search || '';
      const momentum = r.dataset.momentum || '';
      const matchText = !q || text.includes(q);
      const matchFilter = activeFilter === 'all' || momentum === activeFilter;
      const visible = matchText && matchFilter;
      r.style.display = visible ? '' : 'none';
      if (visible) activeCount++;
    });
    if (countEl) {
      const total = rows.length;
      const showing = activeFilter === 'all' && !q
        ? `Showing all ${total.toLocaleString()} projects`
        : `Showing ${activeCount.toLocaleString()} of ${total.toLocaleString()} projects`;
      countEl.textContent = showing;
    }
  }

  input?.addEventListener('input', applyFilter);
  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = (pill as HTMLElement).dataset.filter || 'all';
      applyFilter();
    });
  });
</script>
